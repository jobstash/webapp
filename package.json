{
  "name": "webapp",
  "version": "2.35.7",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm format && pnpm lint",
    "build": "DISABLE_STATIC_GENERATION=true next build --webpack",
    "start": "next start",
    "lint": "oxlint --fix --fix-suggestions",
    "format": "prettier --write --log-level warn './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "test": "vitest",
    "test:run": "vitest run && pnpm test:security && node --test scripts/validate-browser-sentry.test.cjs scripts/build-fixtures.test.cjs",
    "test:security": "node --test scripts/zod-security.test.cjs scripts/zod-vendor-compatibility.test.cjs",
    "worktree:exec": "tsx scripts/worktree-exec.ts",
    "analyze": "DISABLE_STATIC_GENERATION=true ANALYZE_BUNDLE=true next build --webpack"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.112",
    "@ai-sdk/openai": "^4.0.109",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@bprogress/next": "^3.2.12",
    "@d3-maps/atlas": "^1.0.1",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@privy-io/react-auth": "^3.51.3",
    "@privy-io/node": "^0.38.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.11.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "ai": "^7.0.163",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-geo": "^3.1.2",
    "echarts": "^6.1.0",
    "flint-chart": "^1.0.1",
    "input-otp": "^1.5.0",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "next": "16.4.5",
    "nuqs": "^2.10.2",
    "pdf-parse": "^2.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "^3.1.0",
    "transliteration": "^2.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dotenvx/dotenvx": "^2.38.2",
    "@inquirer/prompts": "^8.7.5",
    "@next/bundle-analyzer": "^16.4.5",
    "@prettier/plugin-oxc": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "server-only": "^0.0.1",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm dlx commitlint --edit $1",
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm build && pnpm test"
  },
  "lint-staged": {
    "**/*.{ts,tsx,json,md}": [
      "prettier --write",
      "oxlint --fix --fix-suggestions"
    ]
  }
}
